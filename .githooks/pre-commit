#!/bin/sh
# main 직접 커밋 차단 + 브랜치 이름 경고.
branch=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0

# 최초 커밋(아직 HEAD 없음)은 리포 부트스트랩이므로 허용
git rev-parse --verify HEAD >/dev/null 2>&1 || exit 0

if [ "$branch" = "main" ]; then
  echo "" >&2
  echo "  main에는 직접 커밋하지 않습니다." >&2
  echo "" >&2
  echo "  먼저 브랜치를 파세요:" >&2
  echo "    git switch -c feat/21-transaction-create" >&2
  echo "" >&2
  echo "  이미 스테이징한 건 그대로 따라옵니다." >&2
  echo "" >&2
  exit 1
fi

if ! printf '%s' "$branch" | grep -Eq '^(feat|fix|docs|refactor|chore)/[0-9]+-[a-z0-9.-]+$'; then
  echo "  경고: 브랜치 이름이 '<type>/<이슈번호>-<요약>' 형식이 아닙니다 ($branch)" >&2
  echo "        예) feat/21-transaction-create   —   git branch -m 으로 고칠 수 있습니다" >&2
fi
exit 0
