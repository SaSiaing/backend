{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(go build:*)", "Bash(go test:*)", "Bash(go vet:*)", "Bash(go mod:*)",
      "Bash(gofmt:*)", "Bash(golangci-lint:*)",
      "Bash(sqlc:*)", "Bash(goose:*)",
      "Bash(docker compose ps:*)", "Bash(docker compose logs:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git branch:*)",
      "Bash(gh pr view:*)", "Bash(gh issue view:*)", "Bash(gh issue list:*)"
    ]
  }
}
